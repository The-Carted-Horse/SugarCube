[Unit]
Description=SugarCube glucose display
# An appliance display must never stop retrying.
StartLimitIntervalSec=0

[Service]
Type=simple
User=sugar
Group=sugar
SupplementaryGroups=video render input netdev
WorkingDirectory=/opt/sugarcube
ExecStart=/usr/bin/python3 -m sugarcube --config /home/sugar/config.json
Restart=always
RestartSec=3
# The web admin serves plain http on port 80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# fbdev proved reliable across Pi 4/5 panels; kmsdrm stays as
# the fallback if SUGARCUBE_DISPLAY is ever unset.
Environment=SUGARCUBE_DISPLAY=fbdev
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=dummy
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
