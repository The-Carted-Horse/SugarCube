[Unit]
Description=SugarCube glucose display
# An appliance display must never stop retrying.
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
# video/render for KMS/DRM output, input for the touchscreen/keyboard
SupplementaryGroups=video render input
WorkingDirectory=/home/pi/SugarCube
# Boot guard: counts starts (the app clears the counter once healthy);
# a missing package or three failed starts restores the previous version
# the updater kept as sugarcube.prev.
ExecStartPre=/bin/sh -c 'R=/home/pi/SugarCube; F=$${R}/.boot-fails; N=$$(($$(cat $${F} 2>/dev/null || echo 0)+1)); echo $${N} > $${F}; if [ ! -d $${R}/sugarcube ] && [ -d $${R}/sugarcube.prev ]; then mv $${R}/sugarcube.prev $${R}/sugarcube; echo 0 > $${F}; elif [ $${N} -ge 3 ] && [ -d $${R}/sugarcube.prev ]; then rm -rf $${R}/sugarcube.bad; mv $${R}/sugarcube $${R}/sugarcube.bad; mv $${R}/sugarcube.prev $${R}/sugarcube; echo 0 > $${F}; fi'
ExecStart=/usr/bin/python3 -m sugarcube --config /home/pi/SugarCube/config.json
Restart=always
RestartSec=3
# The web admin serves plain http on port 80.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=dummy
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
